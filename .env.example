# Copy to .env and fill in real values. Never commit .env to version control.

# Flask
SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=0

# Admin credentials (protect the /admin area)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Database & data directory (defaults to ./data/)
# DATA_DIR=/var/data/myguesthouse
# DB_PATH=/var/data/myguesthouse/myguesthouse.db

# AlloggiatiWeb credentials file (defaults to registration/tests/resources/alloggiatiweb_credentials.json)
# ALLOGGIATIWEB_CREDENTIALS_FILE=/path/to/alloggiatiweb_credentials.json

# Config file (defaults to ./config.yaml)
# CONFIG_FILE=/path/to/config.yaml

# Server port (used by gunicorn / Railway)
PORT=5000
